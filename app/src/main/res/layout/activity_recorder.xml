<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <!-- Шапка -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="24dp">

                <Button
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/back_button"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:stateListAnimator="@null"
                    android:text="@string/back"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.02"
                    android:text="@string/recorder_title"
                    android:textColor="@color/ink"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Панель записи -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="20dp"
                android:paddingBottom="18dp">

                <ImageButton
                    android:id="@+id/record"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/mic_button"
                    android:contentDescription="@string/recorder_start"
                    android:scaleType="center"
                    android:src="@drawable/ic_mic"
                    android:stateListAnimator="@null" />

                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.02"
                    android:text="@string/recorder_zero"
                    android:textColor="@color/ink"
                    android:textSize="22sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/level_track">

                    <View
                        android:id="@+id/level"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/level_fill" />
                </FrameLayout>

                <TextView
                    android:id="@+id/record_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="1dp"
                    android:textColor="@color/ink_3"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/target_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/ink_3"
                android:textSize="12sp" />

            <!-- ЗАПИСИ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recorder_section" />

                <TextView
                    android:id="@+id/list_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_3"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card"
                android:lineSpacingExtra="2dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/recorder_empty"
                android:textColor="@color/ink_2"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="1dp"
                android:text="@string/recorder_footer"
                android:textColor="@color/ink_3"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
